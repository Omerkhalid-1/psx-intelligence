# Copy to .env and replace placeholders. Never commit .env.
# APP_ENV selects the config class: development | testing | production
APP_ENV=development

# Required in production; development generates an ephemeral key if unset.
SECRET_KEY=replace_me_with_a_long_random_string

# PostgreSQL is the canonical store.
# Used by compose.yaml to initialise the database container and build DATABASE_URL.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+psycopg://psx:password@localhost:5432/psx_intelligence
# Used only by the test suite. Must point at a disposable database: tests drop and recreate tables.
TEST_DATABASE_URL=postgresql+psycopg://psx:password@localhost:5432/psx_intelligence_test

# Redis: task coordination only (never the permanent store).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Optional rotating log file; leave empty to log to stdout only.
LOG_FILE=

# Bearer token protecting admin / job-triggering endpoints. Required in production.
ADMIN_API_TOKEN=replace_me

# Feature flags — keep disabled until the behaviour has been validated.
ENABLE_SCHEDULED_INGESTION=false
ENABLE_MODEL_TRAINING=false
ENABLE_MODEL_PROMOTION=false

# Directory scanned by the file-import market-data connector (see docs/data_sources.md).
MARKET_DATA_IMPORT_DIR=./data/imports

# Freshness: a market dataset older than this many PSX sessions is reported as stale.
STALE_AFTER_SESSIONS=2

# --- psxdata-api market data (docs/data_sources.md, docs/operations.md) -------------------
# Self-hosted service: run services/psxdata-api/run.sh (local) or the psx-api compose service.
PSXDATA_ENABLED=false
# Local default; compose overrides this with http://psx-api:8000.
PSXDATA_API_URL=http://127.0.0.1:8100
# Read timeout per request; a cache miss on /historical scrapes a symbol's full history.
PSXDATA_TIMEOUT_SECONDS=60
# Attempts per request for transient failures (timeouts, 429, 503); 1-5, exponential backoff.
PSXDATA_MAX_ATTEMPTS=3
# Symbols to ingest (stocks and indices). Indices get daily bars but no quotes.
# Tracked watchlist: every symbol gets daily bars, quotes, the analysis engine and a website page.
# KSE100 is required (benchmark). Adding symbols: follow "Adding a symbol" in docs/operations.md
# (corporate actions must be researched before the indicators are trustworthy).
PSXDATA_SYMBOLS=SYS,FFC,MEBL,MARI,LUCK,DGKC,FCCL,OGDC,PPL,HBL,UBL,MCB,NBP,EFERT,HUBC,KEL,PSO,TRG,INDU,KSE100
# Forecasting universe (subset of PSXDATA_SYMBOLS). Unset = the validated set SYS,FFC,MEBL,MARI,KSE100
# restricted to PSXDATA_SYMBOLS. Adding a symbol here requires re-running experiments and validation.
# MODEL_SYMBOLS=SYS,FFC,MEBL,MARI,KSE100
# Gap between requests (>= 1.0): psxdata-api allows 60 requests/minute per client.
PSXDATA_REQUEST_SPACING_SECONDS=1.0
# Earliest session for a full backfill (YYYY-MM-DD); empty = all available (about 10 years).
PSXDATA_BACKFILL_START=
# Incremental syncs re-fetch this many days before the newest stored bar (catches corrections).
PSXDATA_INCREMENTAL_OVERLAP_DAYS=10
# Scheduled jobs (also need ENABLE_SCHEDULED_INGESTION=true and Celery beat + worker).
PSXDATA_DAILY_SYNC_TIME=18:00
PSXDATA_QUOTE_POLL_INTERVAL_MINUTES=15
PSXDATA_QUOTE_WINDOW=09:15-17:00
# Freshness thresholds shown in the dashboard / health.
PSXDATA_QUOTES_STALE_AFTER_MINUTES=45
PSXDATA_BARS_STALE_AFTER_WEEKDAYS=2

# --- Research layer (docs/research_methodology.md, docs/news_sentiment.md) -------------------------------
ARTIFACTS_DIR=
NEWS_ENABLED=false
# finbert (most accurate in our evaluation; needs requirements-ml.txt, ~1.7 GB) | lexicon_v1 (no extra deps) | phrasebank_lr_v1 (rejected: 50%)
NEWS_SENTIMENT_MODEL=lexicon_v1
NEWS_COVERAGE_START=2023-01-01
ENABLE_RESEARCH_PIPELINE=false
RESEARCH_PIPELINE_TIME=18:30
FORECAST_HORIZONS=1,5,20

# --- Public website ----------------------------------------------------------------------------------------
# Live PSX news search makes outbound Google News requests: per-client and total budgets (per minute).
NEWS_SEARCH_PER_IP_PER_MINUTE=20
NEWS_SEARCH_OUTBOUND_PER_MINUTE=30
SYMBOL_SUGGEST_PER_IP_PER_MINUTE=120
# Seconds an analysis-engine result is reused per web worker.
ENGINE_CACHE_SECONDS=60
# Reverse proxies in front of the app whose X-Forwarded-* headers are trusted (0 = none; 1 behind one proxy).
TRUSTED_PROXY_COUNT=0
# /ops (system health, pipeline, models) requires HTTP Basic auth with ADMIN_API_TOKEN as the password.
# Defaults to true in production, false elsewhere.
# OPS_DASHBOARD_AUTH=
